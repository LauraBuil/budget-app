  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:api\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:api": "node server/index.mjs",
    "build": "tsc -b && vite build",
