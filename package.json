  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.4.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.5",
    "sass": "^1.105.1",
    "sass-embedded": "^1.105.1",
    "typescript": "~5.9.3",
